{
  "name": "supra-l1-sdk-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @supra-l1/sdk -w @supra-l1/mcp-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "npm run docs -w @supra-l1/sdk"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
